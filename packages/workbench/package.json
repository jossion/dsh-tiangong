{
  "name": "@jos/workbench",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Tiangong: a requirement-driven autonomous delivery workbench for DSH.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "*.js",
    "icon.svg"
  ],
  "icon": "./icon.svg",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "preview": "node preview/seed.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
