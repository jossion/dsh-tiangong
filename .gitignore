# macOS
.DS_Store

# local scratch / experiments / screenshots
.tmp/

# local tool state (workbuddy memory)
.workbuddy/

# Workbench runtime data: delivery workspace outputs and imported statements.
# Not source; regenerated by the plugin under ~/.dsh/workbench or projects/.
projects/

# Workbench static preview: generated data and the leftover browser profile
packages/workbench/preview/out/
packages/workbench/preview/.chrome-profile/

# dependencies
node_modules/
